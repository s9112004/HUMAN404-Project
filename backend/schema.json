  "components": {
    "schemas": {
      "AddRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "title": "AddRequest"
      },
      "DeleteRequest": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "DeleteRequest"
      },
      "EC2ActionRequest": {
        "properties": {
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          }
        },
        "type": "object",
        "required": [
          "instance_id"
        ],
        "title": "EC2ActionRequest"
      },
      "EC2LaunchRequest": {
        "properties": {
          "instance_type": {
            "type": "string",
            "title": "Instance Type",
            "default": "t2.micro"
          },
          "ami_id": {
            "type": "string",
            "title": "Ami Id",
            "default": "ami-0aec5ae807cea9ce0"
          }
        },
        "type": "object",
        "title": "EC2LaunchRequest"
      },
      "EC2ModifyRequest": {
        "properties": {
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          },
          "new_instance_type": {
            "type": "string",
            "title": "New Instance Type"
          }
        },
        "type": "object",
        "required": [
          "instance_id",
          "new_instance_type"
        ],
        "title": "EC2ModifyRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "S3BucketRequest": {
        "properties": {
          "bucket_name": {
            "type": "string",
            "title": "Bucket Name"
          }
        },
        "type": "object",
        "required": [
          "bucket_name"
        ],
        "title": "S3BucketRequest"
      },
      "S3FileRequest": {
        "properties": {
          "bucket_name": {
            "type": "string",
            "title": "Bucket Name"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content",
            "default": "這是由 AI 自動建立的檔案內容"
          }
        },
        "type": "object",
        "required": [
          "bucket_name",
          "file_name"
        ],
        "title": "S3FileRequest"
      },
      "SearchRequest": {
        "properties": {
          "keyword": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keyword",
            "description": "搜尋關鍵字，若要列出全部可留空"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "description": "回傳筆數限制，預設 50 筆",
            "default": 50
          },
          "sort": {
            "type": "string",
            "enum": [
              "newest",
              "oldest"
            ],
            "title": "Sort",
            "description": "排序方式：'newest' 為最新(預設)，'oldest' 為最舊",
            "default": "newest"
          }
        },
        "type": "object",
        "title": "SearchRequest"
      },
      "UpdateRequest": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "UpdateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}