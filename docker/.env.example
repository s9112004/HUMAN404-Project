# --- 資料庫設定 (Database) ---
# Default credentials for development
POSTGRES_USER=admin
POSTGRES_PASSWORD=dify_password
POSTGRES_DB=dify

# --- 應用程式設定 (App) ---
# Generate a random string for production
SECRET_KEY=sk-fast-api-random-string-here

# --- 儲存設定 (Storage) ---
STORAGE_TYPE=local
STORAGE_LOCAL_ROOT=/app/api/storage

# --- URL 設定 (URL) ---
# If accessing from the same machine: http://localhost
# If accessing from another machine: http://YOUR_SERVER_IP (e.g., http://192.168.1.100)
CONSOLE_API_URL=http://localhost
CONSOLE_WEB_URL=http://localhost
SERVICE_API_URL=http://localhost
APP_API_URL=http://localhost

# --- AWS 設定 (Optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
